<nta>
	<declaration>const int N = 2;
const int QSIZE = 4;

typedef int[0,N-1] task_t;
typedef int[0,QSIZE] qindex_t;

chan request[N];
chan release[N];

task_t queue[QSIZE];

qindex_t head = 0;
qindex_t tail = 0;
qindex_t count = 0;

task_t selected = 0;

void enqueue(task_t id) {
    queue[tail] = id;
    tail = (tail + 1) % QSIZE;
    count++;
}

task_t dequeue() {
    task_t id;
    id = queue[head];
    head = (head + 1) % QSIZE;
    count--;
    return id;
}</declaration>
	<template>
		<name x="5" y="5">Worker</name>
		<parameter>const task_t id</parameter>
		<declaration>// Place local declarations here.

clock x;</declaration>
