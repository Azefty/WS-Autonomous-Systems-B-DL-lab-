<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// Place global declarations here.
clock x;</declaration>
	<template>
		<name x="5" y="5">Template</name>
		<declaration>// Place local declarations here.
</declaration>
		<location id="id0" x="-17" y="-42">
			<name x="-27" y="-76">Closed</name>
		</location>
		<location id="id1" x="195" y="-51">
			<name x="185" y="-85">Open</name>
			<label kind="invariant" x="186" y="-17">x &lt;= 10</label>
		</location>
		<location id="id2" x="306" y="59">
			<name x="296" y="25">Alarm</name>
		</location>
		<init ref="id0"/>
		<transition id="id3">
			<source ref="id1"/>
			<target ref="id2"/>
			<label kind="guard" x="178" y="17">x &gt;= 10</label>
		</transition>
		<transition id="id4">
			<source ref="id1"/>
			<target ref="id0"/>
			<label kind="guard" x="1" y="-97">x &lt; 10</label>
			<nail x="110" y="-85"/>
		</transition>
		<transition id="id5">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="assignment" x="59" y="-42">x = 0</label>
		</transition>
	</template>
	<system>// Place template instantiations here.
Process = Template();
// List one or more processes to be composed into a system.
system Process;
</system>
	<queries>
		<query>
			<formula/>
			<comment/>
		</query>
	</queries>
</nta>
