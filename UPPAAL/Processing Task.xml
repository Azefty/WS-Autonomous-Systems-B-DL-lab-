			<label kind="guard" x="-144" y="-331">x &gt;= 2</label>
			<nail x="-162" y="-293"/>
		</transition>
		<transition id="id5">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="assignment" x="-330" y="-187">x=0</label>
			<nail x="-348" y="-187"/>
		</transition>
	</template>
	<system>// Place template instantiations here.
Process = Template();
// List one or more processes to be composed into a system.
system Process;
</system>
	<queries>
		<query>
			<formula/>
			<comment/>
		</query>
	</queries>
